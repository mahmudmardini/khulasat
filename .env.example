APP_NAME="خُلاصات"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── قاعدة البيانات ─────────────────────────────────────────────
# القيم هنا للتشغيل على الجهاز نفسه.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=khulasah
DB_USERNAME=khulasah
DB_PASSWORD=secret

# ── Redis والطوابير ────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# كعكةُ الجلسة على HTTPS وحدها. **ولا تُضبط هنا**: تصير `true` وحدها متى
# كان APP_ENV=production ({@see config/session.php})، وتبقى `false` محليّاً
# وإلّا لم يُحفظ الدخولُ على http://localhost. والسطرُ لمن أراد خلافهما.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

HORIZON_PREFIX=khulasah_horizon:

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@khulasat.io"
MAIL_FROM_NAME="${APP_NAME}"

# ── النماذج — القيم الافتراضية، والفعلي من جدول model_config ──
# مفاتيح الواجهات هنا فقط. لا في قاعدة البيانات ولا في model_config
# ولا في الكود. انظر CLAUDE.md §2 القاعدة السادسة.
MODEL_PROVIDER_DEFAULT=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

# البوّابة الوهمية هي الافتراضية في local وtesting، فلا تُحرق توكنز
# في التطوير. انظر المواصفة §6-أ «البوّابة الوهمية».
#
# **وللتشغيل الحقيقي:** ضع المفتاحين أعلاه، ثمّ بدّلها إلى `real`، ثمّ
# شغّل `php artisan khulasah:preflight` — يقول ما ينقص قبل أن يُصرف ريال.
# و`real` وحدها تفتحها؛ أيّ قيمة أخرى تُبقي الوهمية.
MODEL_GATEWAY=fake

# نقاط النهاية — تُبدَّل عند استعمال وسيط أو نسخة مؤسّسية.
ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
GOOGLE_AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# ── التفريغ ────────────────────────────────────────────────────
YTDLP_BIN=/usr/local/bin/yt-dlp
YTDLP_TIMEOUT=300

# والفحصُ السريع يجري في دورة الطلب لا في الطابور، فمهلتُه أقصر: مضيفٌ
# بطيءٌ يحبس عامل PHP-FPM طولَ المهلة. T-124.
YTDLP_PREFLIGHT_TIMEOUT=60

# فيديو اختبار ثابت للفحص الأسبوعي — §5-أ-6 البند ٢. يوتيوب يكسر yt-dlp
# كثيراً، والانكسار لا يظهر إلا في نداءٍ حقيقي.
TRANSCRIPT_CANARY_URL=

# وكيل سكنيّ — المواصفة §5-أ-6 البند ١. يوتيوب يحجب عناوين مراكز
# البيانات، وهذا واقعٌ متكرّر لا احتمال. وفارغاً لا يُمرَّر العلَم البتّة.
YTDLP_PROXY=

# الصوت — §5-أ-4. التقطيع عند الصمت لا عند زمن ثابت، لئلّا تُقطع الكلمة.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_TIMEOUT=900
TRANSCRIPT_CHUNK_SECONDS=600
SILENCE_NOISE_DB=-30dB
SILENCE_MIN_SECONDS=0.5
# والبديلُ حين لا سكتةَ صريحة قرب القطع (قاعةٌ فيها مروحة أو صدى): نَفَسٌ أقصر وأقلّ هدوءاً.
SILENCE_SOFT_NOISE_DB=-20dB
SILENCE_SOFT_MIN_SECONDS=0.2

# خدمة التفريغ. **فارغةً يعمل التنفيذ الوهميّ** — CLAUDE.md §2 القاعدة
# السابعة: لا نداء تفريغ حقيقي في التطوير المحلّي ولا في CI.
# مصدر المصحف وترجماته — T-161. تطبيق خادم في Developer Console لدى Quran Foundation.
# بلا هذين لا مزامنة، وشروطهم لا تُجيز حفظ المحتوى أكثر من أسبوع بلا مزامنة.
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=

WHISPER_PROVIDER=
WHISPER_API_KEY=
WHISPER_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
WHISPER_MODEL=whisper-1
WHISPER_TIMEOUT=600
# حدّ المزوّد للملفّ الواحد — تجاوزُه هو ما يُوجب التقطيع.
WHISPER_MAX_BYTES=26214400

# **Gemini مزوّداً للتفريغ** — اكتب WHISPER_PROVIDER=gemini، ويكفي
# GOOGLE_AI_API_KEY أعلاه: لا مفتاح ثانٍ. وقيم WHISPER_* السابقة لا تُقرأ
# معه. ويخدم رفع الملفّ ورابط يوتيوب بلا ترجمة عربية معاً.
# تعليماته في prompts/transcription/GEMINI.md.
GEMINI_TRANSCRIBE_MODEL=gemini-3.7-flash
# حدّ الطلب عند Gemini 20MB بعد base64. و5MB من الصوت الموحَّد نحو ربع ساعة.
GEMINI_TRANSCRIBE_MAX_BYTES=5242880
# تقديرٌ بالتوكنز لا سعرٌ معلَن — يُراجَع على أوّل فاتورة.
GEMINI_TRANSCRIBE_PRICE_PER_MINUTE=0.003

# رفع ملفّ من الجهاز — §5-أ-4-ب: حتى 500MB.
UPLOAD_MAX_BYTES=524288000
# **يُرفع أجزاءً لا في طلبٍ واحد**: الجزءُ الساقط يُعاد وحده، والرفعُ يُستأنف.
# فيكفي أن يقبل nginx الجزءَ الواحد (client_max_body_size 11m) لا 500MB، ولا
# يتجاوز الجزءُ post_max_size في PHP أبداً — يُنزَل إليه آليّاً.
UPLOAD_CHUNK_BYTES=10485760
# رفعٌ لم يكتمل أو لم يُرسَل نموذجُه يُكنس بأجزائه بعد هذه الساعات (كنسٌ كلّ ساعة).
UPLOAD_STALE_HOURS=24
# ملفُّ مهمّةٍ أخفقت إخفاقاً عارضاً يُبقى لـ«أعد المحاولة» هذه الأيّام.
UPLOAD_RETENTION_DAYS=3
UPLOAD_TEXT_MAX_BYTES=5242880

# ── المصادر الشرعية ────────────────────────────────────────────
# لا إعداد هنا عمداً — قرار مالك المنتج، 6 أيلول 2026.
#
# مدوّنة الحديث والأحكام مصدرٌ واحد مفتوح برخصة Unlicense، تُبذر
# بأمر khulasah:seed-hadith وتعيش في قاعدتنا. لا واجهة خارجية،
# ولا مفتاح، ولا حدّ استعمال، ولا إذن من أحد — المواصفة §7-3.

# ── التخزين ────────────────────────────────────────────────────
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_USE_PATH_STYLE_ENDPOINT=true
CDN_BASE_URL=

# ── سقوف الإنفاق ───────────────────────────────────────────────
SPEND_CAP_DAILY_USD=50
SPEND_CAP_MONTHLY_USD=800

# ── دخولُ لجنة التحكيم بنقرة — T-186 ───────────────────────────
# الحساباتُ ينشئها `php artisan khulasah:seed-judges`. وبلا رمزٍ تظهر الأزرار
# في local وحدها. **وعلى خادمٍ عامّ ضع رمزاً طويلاً**، فلا تظهر إلّا على
# /panel/login?judge=<الرمز>.
JUDGE_LOGIN=true
JUDGE_LOGIN_KEY=

VITE_APP_NAME="${APP_NAME}"

# بطاقةُ مشاركة الخلاصة — T-144. none: بطاقةُ المنصّة لكلّ خلاصة.
# chrome: بطاقةٌ لكلّ خلاصة، ويلزمها متصفّحٌ على الخادم (DEPLOY.md §4).
SHARE_CARD_CAPTURER=none
SHARE_CARD_CHROME_BINARY=/usr/bin/google-chrome
SHARE_CARD_TIMEOUT=25
SHARE_CARD_NO_SANDBOX=false
